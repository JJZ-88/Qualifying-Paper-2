( xm[-1]/2 <= -cumsum(xm)[-m_upper] )*( cumsum(xm)[-m_upper] <= 2*xm[-1] )*( sign(cumsum(xm)[-m_upper])*sign(xm[-1]) == -1 )
pcols <- rep("black", length(exact_sub))
pcols[!exact_sub] <- "red"
plot(cumsum(xm)[-m_upper], xm[-1], xlab = "Sum of first m terms", ylab = "Term m+1", col=pcols, cex = 2)
abline(a=0,b=-1, col="blue")
abline(a=0,b=-1/2, col="blue",lty="dashed")
abline(a=0,b=-2, col="blue",lty="dashed")
